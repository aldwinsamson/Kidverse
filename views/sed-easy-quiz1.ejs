<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emotion Quiz1</title>
    <link rel="stylesheet" href="/sed-easy-quiz1.css">
    <style>
        body {
            background-image: url('/background-img.png');
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: cover;
            cursor: url('/custom-cursor.png'), auto; 
        }
    </style> 
</head>
<body>
    <div class="quiz-container">
        <div class="quiz-image" onclick="checkAnswer('happy')">
            <img src="/happy-image.png" alt="Happy">
        </div>
        <div class="quiz-image" onclick="checkAnswer('sad')">
            <img src="/sad-image.png" alt="Sad">
        </div>
    </div>

    <div id="myModal" class="modal">
        <div id="modal-content" class="modal-content">
            <img id="feedback-icon" src="" alt="Feedback Icon">
            <p id="feedback-text"></p>
            <button id="modal-button" class="close-button">Close</button>
        </div>
    </div>

    <script>
let score1 = 0;

function checkAnswer(selectedEmotion) {
    const correctAnswer = 'happy';
    const modal = document.getElementById('myModal');
    const modalContent = document.getElementById('modal-content');
    const feedbackText = document.getElementById('feedback-text');
    const feedbackIcon = document.getElementById('feedback-icon');
    const modalButton = document.getElementById('modal-button');

    if (selectedEmotion === correctAnswer) {
        feedbackText.textContent = 'Yey! Correct.';
        feedbackIcon.src = '/check-icon.png';
        modalContent.className = 'modal-content correct';
        score1++;
    } else {
        feedbackText.textContent = 'Wrong answer.';
        feedbackIcon.src = '/cross-icon.png';
        modalContent.className = 'modal-content incorrect';
    }

    modal.style.display = 'block';
    modalButton.textContent = 'Back to Quizzes';
    modalButton.onclick = function() {
        closeModal(true);
    };

    saveUserProgress(score1, 'quiz1');
    updateScores();
}

function closeModal(endSession) {
    const modal = document.getElementById('myModal');
    modal.style.display = 'none';
    if (endSession) {
        window.location.href = '/sed-for-1-3-years-old';
    }
}

function saveUserProgress(score, quizId) {
    const userId = '123'; // Replace with actual userId
    fetch(`/api/user-progress/${quizId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ userId, score })
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Failed to save progress');
        }
    })
    .catch(error => {
        console.error('Error saving user progress:', error);
    });
}

function getUserProgress() {
    const userId = '123'; // Replace with actual userId
    fetch(`/api/user-progress/${userId}`)
    .then(response => response.json())
    .then(data => {
        document.getElementById('score1').textContent = data.quiz1 || 0;
        document.getElementById('score2').textContent = data.quiz2 || 0;
    })
    .catch(error => {
        console.error('Error fetching user progress:', error);
    });
}

function updateScores() {
    document.getElementById('score1').textContent = score1;
    document.getElementById('score2').textContent = 0; // Fetch and update score for quiz 2 if needed
}

// Fetch scores when the page loads
document.addEventListener('DOMContentLoaded', getUserProgress);
    </script>
</body>
</html>