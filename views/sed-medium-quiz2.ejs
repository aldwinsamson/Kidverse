<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emotion Quiz</title>
    <link rel="stylesheet" href="/sed-medium-quiz2.css">
    <style>
        body {
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: cover;
            cursor: url('/custom-cursor.png'), auto; 
        }

    </style>
</head>
<body>
    <div id="quiz-container" class="quiz-container">
        <div id="stage-1" class="quiz-stage">
            <div class="quiz-image" onclick="checkAnswer('happy', 'happy', 1)">
                <img src="/sad-image.png" alt="Happy">
            </div>
            <div class="quiz-image" onclick="checkAnswer('sad', 'happy', 1)">
                <img src="/happy-image.png" alt="Sad">
            </div>
        </div>
        <div id="stage-2" class="quiz-stage" style="display: none;">
            <div class="quiz-image" onclick="checkAnswer('angry', 'angry', 2)">
                <img src="/angry-image.png" alt="Angry">
            </div>
            <div class="quiz-image" onclick="checkAnswer('surprised', 'angry', 2)">
                <img src="/surprised-image.png" alt="Surprised">
            </div>
        </div>
        <div id="stage-3" class="quiz-stage" style="display: none;">
            <div class="quiz-image" onclick="checkAnswer('excited', 'excited', 3)">
                <img src="/excited-image.png" alt="Excited">
            </div>
            <div class="quiz-image" onclick="checkAnswer('bored', 'excited', 3)">
                <img src="/bored-image.png" alt="Bored">
            </div>
        </div>
    </div>

    <div id="myModal" class="modal">
        <div id="modal-content" class="modal-content">
            <img id="feedback-icon" src="" alt="Feedback Icon">
            <p id="feedback-text"></p>
            <button id="modal-button" class="close-button" onclick="closeModal()">Close</button>
        </div>
    </div>

    <div id="result-modal" class="modal">
        <div id="result-modal-content" class="modal-content result-modal-content">
            <p id="result-text"></p>
            <button id="result-button-home" class="result-button" onclick="goHome()">Back to Quizzes</button>
            <button id="result-button-try-again" class="result-button" onclick="tryAgain()">Try Again</button>
        </div>
    </div>

    <div id="score-container" style="display: none; text-align: center; margin-top: 50px;">
        <h2>Your Score: <span id="score"></span>/3</h2>
    </div>

    <script>
let score2 = 0;
const backgrounds = [
    'url(/background-img1.png)',
    'url(/background-img2.png)',
    'url(/background-img3.png)',
    'url(/background-score.png)'
];

document.body.style.backgroundImage = backgrounds[0];

function checkAnswer(selectedEmotion, correctEmotion, stage) {
    const modal = document.getElementById('myModal');
    const modalContent = document.getElementById('modal-content');
    const feedbackText = document.getElementById('feedback-text');
    const feedbackIcon = document.getElementById('feedback-icon');
    const modalButton = document.getElementById('modal-button');

    if (selectedEmotion === correctEmotion) {
        feedbackText.textContent = 'Yay! Correct.';
        feedbackIcon.src = '/check-icon.png';
        modalContent.className = 'modal-content correct';
        score2++;
    } else {
        feedbackText.textContent = 'Wrong answer.';
        feedbackIcon.src = '/cross-icon.png';
        modalContent.className = 'modal-content incorrect';
    }

    modal.style.display = 'block';

    modalButton.onclick = function() {
        closeModal();
        if (stage < 3) {
            document.getElementById(`stage-${stage}`).style.display = 'none';
            document.getElementById(`stage-${stage + 1}`).style.display = 'flex';
            document.body.style.backgroundImage = backgrounds[stage];
        } else {
            document.getElementById('quiz-container').style.display = 'none';
            document.getElementById('score-container').style.display = 'block';
            document.body.style.backgroundImage = backgrounds[3];
            document.getElementById('score').textContent = score2;
            saveUserProgress(score2, 'quiz2');
            showResultModal();
        }
    };
}

function closeModal() {
    const modal = document.getElementById('myModal');
    modal.style.display = 'none';
}

function showResultModal() {
    const resultModal = document.getElementById('result-modal');
    const resultText = document.getElementById('result-text');
    const resultButtonHome = document.getElementById('result-button-home');
    const resultButtonTryAgain = document.getElementById('result-button-try-again');

    if (score2 >= 2) {
        resultText.textContent = `Congratulations! You passed with a score of ${score2}/3.`;
        resultButtonHome.style.display = 'inline-block';
        resultButtonTryAgain.style.display = 'none';
    } else {
        resultText.textContent = `Sorry, you didn't pass. Your score is ${score2}/3.`;
        resultButtonHome.style.display = 'none';
        resultButtonTryAgain.style.display = 'inline-block';
    }

    resultModal.style.display = 'block';
}

function goHome() {
    window.location.href = '/sed-for-1-3-years-old';
}

function tryAgain() {
    score2 = 0;
    document.getElementById('quiz-container').style.display = 'flex';
    document.getElementById('score-container').style.display = 'none';
    document.getElementById('stage-1').style.display = 'flex';
    document.getElementById('stage-2').style.display = 'none';
    document.getElementById('stage-3').style.display = 'none';
    document.body.style.backgroundImage = backgrounds[0];
    const resultModal = document.getElementById('result-modal');
    resultModal.style.display = 'none';
}

function saveUserProgress(score, quizId) {
    const userId = '123'; 
    fetch(`/api/user-progress/${quizId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ userId, score })
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Failed to save progress');
        }
    })
    .catch(error => {
        console.error('Error saving user progress:', error);
    });
}

    </script>
</body>
</html>