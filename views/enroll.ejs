<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enroll</title>
<link rel="stylesheet" href="/menu-style.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    body {
        font-family: Arial, sans-serif;
        background-image: url(/enroll-bg.svg);
        margin: 0;
        padding: 0;
    }
    
</style>
</head>
<body>
    <div class="video-container">
        <video controls class="video-bg">
            <source src="/lesson-introduction.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    </div>
    
    <div class="sidebar" id="sidebar">
        <button class="back-button" onclick="toggleSidebar()">
            <img src="/logo-icon.png" alt="Back">
        </button>
        <ul>
            <li><a href="/homepage"><img src="/home-button-icon.png" alt="Home"> Home</a></li>
            <li><a href="/enroll"><img src="/enroll-button-con.png" alt="Enroll"> Enroll</a></li>
            <li><a href="/profile"><img src="/profile-button-icon.png" alt="Profile"> Profile</a></li>
            <li><a href="/about-us"><img src="/about-us-button-icon.png" alt="About Us"> About Us</a></li>
            <li><a href="#" onclick="confirmLogout()"><img src="/logout-button-icon.png" alt="Logout"> Logout</a></li>
        </ul>
    </div>

    <div class="menu-btn" onclick="toggleSidebar()">
        <img src="/logo-icon.png" alt="Logo" class="logo">
    </div>

    <nav class="center">
        <b><a href="/subject-for-1-3-years-old">1-3 YEARS OLD</a></b>
        <b><a href="/subject-for-kindergarten">KINDERGARTEN</a></b>
        <b><a href="/subject-for-grade-1-2">GRADE 1-2</a></b>
    </nav>

<script>
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var sidebarWidth = sidebar.offsetWidth;
            if (sidebar.style.left === '-250px') {
                sidebar.style.left = '0';
            } else {
                sidebar.style.left = '-250px';
            }
        }

        function confirmLogout() {
        const swalWithBootstrapButtons = Swal.mixin({
        customClass: {
            confirmButton: "btn btn-success",
            cancelButton: "btn btn-danger"
        },
        buttonsStyling: false
    });

        swalWithBootstrapButtons.fire({
            title: "Are you sure you want to log out?",
            text: "See you again next time!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, logout!",
            cancelButtonText: "No",
            reverseButtons: true,
            padding: '2em',
            background: '#f8f9fa'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/logout', {
                    method: 'POST',
                    headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include' // To include cookies in the request
        }).then(response => {
            if (response.ok) {
                history.pushState(null, null, location.href);
                window.onpopstate = function () {
                    history.go(1);
                    };
                    window.location.href = "/";
            } else {
                    // Handle error if needed
                    console.error('Logout failed');
            }
            }).catch(error => {
                console.error('Error:', error);
            });
        }
    });
}

     document.getElementById('logoutButton').addEventListener('click', logout);
</script>
</body>
</html>
