# copy this file to ".env" and fill in real values. never commit ".env"

# mongodb atlas connection string
MONGO_URL=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority

# long random string used to sign session cookies
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# mailbox that sends the password reset codes
EMAIL_SERVICE=outlook
EMAIL_USER=your-address@example.com
EMAIL_PASS=your-mailbox-password-or-app-password

# optional
PORT=5000
NODE_ENV=development
